# OpenAI-compatible endpoint. Default = self-hosted ollama-swap.
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Used to transcribe uploaded images. Defaults to LLM_MODEL if omitted.
VISION_MODEL=

# Defaults to LLM_* if omitted
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

DATABASE_PATH=./data/dossier.db
# venv dev: :3000 / :8000. docker compose: host ports below (Cloudflare Tunnel).
WEB_HOST_PORT=18470
API_HOST_PORT=18471
# Baked into the web image at build. Stage: the public API hostname (https, no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:18471
# Comma-separated. LAN IPs on :3000 (192.168.x.x) are also allowed.
# Stage: the public desk origin only, e.g. https://dossier-stage.example.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:18470,http://127.0.0.1:18470
LOG_LEVEL=INFO

# USD per 1M tokens. Leave at 0 for self-hosted. OpenAI list prices (2026-09):
# PRICE_EMBED_PER_1M=0.02
# PRICE_LLM_IN_PER_1M=0.15
# PRICE_LLM_OUT_PER_1M=0.60
PRICE_EMBED_PER_1M=0
PRICE_LLM_IN_PER_1M=0
PRICE_LLM_OUT_PER_1M=0

# Seeded on first boot if that email is not already a user.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Web: retrieval ranks + rewritten query. Off in the happy path.
# NEXT_PUBLIC_DEBUG=1
